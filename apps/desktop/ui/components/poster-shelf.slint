import { AnimeCard, AnimePosterCard } from "anime-poster-card.slint";
import { Theme } from "../theme.slint";

export component PosterShelf inherits VerticalLayout {
    in property <string> heading: "";
    in property <[AnimeCard]> cards;
    in property <string> selected-key: "";

    callback activated(string);

    spacing: 14px;

    if root.heading != "": HorizontalLayout {
        spacing: 10px;
        alignment: start;
        cross-axis-alignment: center;

        Rectangle {
            width: 3px;
            height: 18px;
            border-radius: 2px;
            background: Theme.accent;
        }

        Text {
            text: root.heading;
            color: Theme.text-primary;
            font-size: 18px;
            font-weight: 700;
            vertical-alignment: center;
        }

        if root.cards.length > 0: Rectangle {
            height: 20px;
            border-radius: 10px;
            background: Theme.surface-elevated;
            border-width: 1px;
            border-color: Theme.border;

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                alignment: center;
                cross-axis-alignment: center;

                Text {
                    text: root.cards.length;
                    font-size: 11px;
                    font-weight: 600;
                    color: Theme.text-secondary;
                    vertical-alignment: center;
                }
            }
        }
    }

    FlexboxLayout {
        spacing: Theme.gap;
        flex-direction: row;
        flex-wrap: wrap;
        alignment: start;

        for card in root.cards: AnimePosterCard {
            card: card;
            selected: card.key == root.selected-key;
            clicked(key) => { root.activated(key); }
        }
    }
}
