import { Button } from "std-widgets.slint";
import { Theme } from "../theme.slint";

export component PrimaryButton inherits Button {
    in property <string> label: "";
    in property <length> min-button-width: 0px;

    text: root.label != "" ? root.label : "";
    primary: true;
    min-width: root.min-button-width;
}

export component SecondaryButton inherits Button {
    in property <string> label: "";
    in property <length> min-button-width: 0px;

    text: root.label != "" ? root.label : "";
    primary: false;
    min-width: root.min-button-width;
}

export component ToggleButton inherits Button {
    in property <string> label: "";
    in property <bool> selected: false;
    in property <length> min-button-width: 0px;

    text: root.label != "" ? root.label : "";
    primary: root.selected;
    min-width: root.min-button-width;
}
