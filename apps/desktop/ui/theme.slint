// MutsukiTube Cupertino Dark Theme design tokens.
// Clean, native desktop surface system inspired by macOS / iOS Cupertino standards.

export global Theme {
    // Surfaces
    out property <color> bg: #1c1c1e;
    out property <color> sidebar-bg: #161618;
    out property <color> surface: #252528;
    out property <color> surface-hover: #2f2f34;
    out property <color> surface-active: #38383e;
    out property <color> surface-elevated: #2c2c2e;
    out property <color> surface-sunken: #141416;

    // Apple Cupertino Accent
    out property <color> accent: #0a84ff;
    out property <color> accent-hover: #409cff;
    out property <color> accent-soft: #0a84ff26;

    // Typography
    out property <color> text-primary: #ffffff;
    out property <color> text-secondary: #a1a1a6;
    out property <color> text-muted: #636366;

    // Lines & Separators
    out property <color> border: #2e2e32;
    out property <color> border-strong: #3e3e44;

    // Semantic Status
    out property <color> success: #30d158;
    out property <color> danger: #ff453a;

    // Geometry
    out property <length> radius: 8px;
    out property <length> radius-sm: 6px;
    out property <length> poster-width: 148px;
    out property <length> poster-height: 222px;
    out property <length> gap: 16px;

    // Controls
    out property <length> control-height: 34px;
    out property <length> control-radius: 6px;
}
