// MutsukiTube Anime design tokens.
// Dark, media-library inspired surface system. Keep values here so the Anime
// section stays visually consistent and easy to retune.

export global Theme {
    // Surfaces
    out property <color> bg: #0e0f12;
    out property <color> surface: #16181d;
    out property <color> surface-hover: #1f232b;
    out property <color> surface-elevated: #1a1d24;
    out property <color> surface-sunken: #101216;

    // Accent
    out property <color> accent: #7c5cff;
    out property <color> accent-hover: #9077ff;
    out property <color> accent-soft: #2a2350;

    // Text
    out property <color> text-primary: #f3f4f6;
    out property <color> text-secondary: #a8adb8;
    out property <color> text-muted: #6f7683;

    // Lines
    out property <color> border: #262a33;
    out property <color> border-strong: #3a404c;

    // Status
    out property <color> success: #43c59e;
    out property <color> danger: #e5645f;

    // Geometry
    out property <length> radius: 10px;
    out property <length> radius-sm: 6px;
    out property <length> poster-width: 148px;
    out property <length> poster-height: 222px;
    out property <length> gap: 16px;

    // Controls
    out property <length> control-height: 38px;
    out property <length> control-radius: 8px;
}
