
import {
    Slider,
    VerticalBox,
    HorizontalBox,
    ComboBox,
    ScrollView,
    Spinner,
} from "std-widgets.slint";

import { PrimaryButton, SecondaryButton } from "../components/action-button.slint";

export component WatchPage inherits Rectangle {
    in property <string> video-title;
    in property <string> channel;
    in property <string> video-id;

    in property <[string]> playlists;
    in property <string> library-status: "";

    in property <bool> player-ready: false;
    in property <bool> player-paused: true;
    in property <bool> player-muted: false;

    in-out property <float> playback-position: 0;
    in property <float> playback-duration: 0;
    in property <float> playback-volume: 70;

    in property <string> playback-state: "idle";
    in property <bool> fullscreen-mode: false;

    // True while the user is dragging the seek slider or stepping it with the
    // keyboard. Rust must not overwrite `playback-position` during that window.
    in-out property <bool> seeking: false;

    out property <length> video-surface-x:
        video-surface.absolute-position.x;

    out property <length> video-surface-y:
        video-surface.absolute-position.y;

    out property <length> video-surface-width:
        video-surface.width;

    out property <length> video-surface-height:
        video-surface.height;

    callback back();
    callback play(string);

    callback toggle-favorite();
    callback add-to-playlist(string);

    callback toggle-playback();
    callback stop-playback();

    callback seek-playback(float);
    callback change-volume(float);

    callback replay();
    callback toggle-fullscreen();

    callback open-in-browser(string);

    background: #0f0f0f;

    VerticalBox {
        padding: root.fullscreen-mode ? 0px : 20px;
        spacing: root.fullscreen-mode ? 4px : 16px;

        if !root.fullscreen-mode: HorizontalBox {
            spacing: 12px;

            SecondaryButton {
                label: "‹ Back";
                min-button-width: 84px;

                clicked => {
                    root.back();
                }
            }

            Text {
                text: "MutsukiTube";
                color: white;
                font-size: 22px;
                font-weight: 700;
                vertical-alignment: center;
            }

            Rectangle {
                horizontal-stretch: 1;
                background: transparent;
            }
        }

        video-surface := Rectangle {
            min-height: root.fullscreen-mode ? 0px : 360px;
            max-height: root.fullscreen-mode ? 10000px : 360px;

            horizontal-stretch: 1;
            vertical-stretch: root.fullscreen-mode ? 1 : 0;

            background: #050505;

            border-radius: root.fullscreen-mode ? 0px : 8px;

            if root.playback-state == "loading": Spinner {
                width: 48px;
                height: 48px;
                indeterminate: true;

                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }

            if root.playback-state == "error": Rectangle {
                width: parent.width;
                height: parent.height;

                background: #050505;

                VerticalBox {
                    alignment: center;
                    spacing: 16px;

                    Text {
                        text: "Failed to load video";

                        color: white;
                        font-size: 22px;
                        font-weight: 700;

                        horizontal-alignment: center;
                    }

                    Text {
                        text: "YouTube may be restricting playback.";

                        color: #aaaaaa;
                        font-size: 14px;

                        horizontal-alignment: center;
                    }

                    HorizontalBox {
                        alignment: center;
                        spacing: 12px;

                        PrimaryButton {
                            label: "Retry";

                            clicked => {
                                root.play(root.video-id);
                            }
                        }

                        SecondaryButton {
                            label: "Open in Browser";

                            clicked => {
                                root.open-in-browser(root.video-id);
                            }
                        }
                    }
                }
            }
        }

        VerticalBox {
            spacing: 6px;

            seek-slider := Slider {
                minimum: 0;

                maximum: root.playback-duration > 0
                    ? root.playback-duration
                    : 1;

                value <=> root.playback-position;

                enabled: root.player-ready
                    && root.playback-duration > 0
                    && root.playback-state != "loading";

                changed(value) => {
                    root.seeking = true;
                }

                released(value) => {
                    root.seeking = false;
                    root.seek-playback(value);
                }
            }

            HorizontalBox {
                spacing: 8px;

                Text {
                    text: root.playback-position.to-fixed(0)
                        + "s";

                    color: #aaaaaa;
                    font-size: 13px;
                }

                Rectangle {
                    horizontal-stretch: 1;
                    background: transparent;
                }

                Text {
                    text: root.playback-duration.to-fixed(0)
                        + "s";

                    color: #aaaaaa;
                    font-size: 13px;
                }
            }
        }

        HorizontalBox {
            spacing: 10px;

            PrimaryButton {
                label: root.player-paused
                    ? "▶ Play"
                    : "⏸ Pause";

                enabled: root.player-ready;

                clicked => {
                    root.toggle-playback();
                }
            }

            SecondaryButton {
                label: "■ Stop";
                enabled: root.player-ready;

                clicked => {
                    root.stop-playback();
                }
            }

            SecondaryButton {
                label: "↻ Replay";

                enabled: root.playback-state == "finished"
                    && root.video-id != "";

                clicked => {
                    root.replay();
                }
            }

            SecondaryButton {
                label: root.fullscreen-mode
                    ? "⤢ Exit Fullscreen"
                    : "⛶ Fullscreen";

                enabled: root.player-ready;

                clicked => {
                    root.toggle-fullscreen();
                }
            }

            Rectangle {
                horizontal-stretch: 1;
                background: transparent;
            }

            Text {
                text: root.player-muted
                    ? "Muted"
                    : "Volume";

                color: root.player-muted
                    ? #ff7777
                    : white;

                vertical-alignment: center;
            }

            Slider {
                minimum: 0;
                maximum: 100;
                step: 1;

                value: root.playback-volume;
                enabled: root.player-ready;

                horizontal-stretch: 1;

                changed(value) => {
                    root.change-volume(value);
                }
            }

            Text {
                text: root.playback-volume.to-fixed(0)
                    + "%";

                color: #aaaaaa;
                vertical-alignment: center;
            }
        }

        if !root.fullscreen-mode: ScrollView {
            horizontal-stretch: 1;
            vertical-stretch: 1;

            horizontal-scrollbar-policy: always-off;
            vertical-scrollbar-policy: as-needed;

            VerticalBox {
                padding: 4px;
                spacing: 16px;

                Text {
                    text: root.video-title;
                    color: white;
                    font-size: 23px;
                    font-weight: 700;
                    wrap: word-wrap;
                }

                Text {
                    text: root.channel;
                    color: #aaaaaa;
                    font-size: 16px;
                    wrap: word-wrap;
                }

                HorizontalBox {
                    spacing: 12px;

                    SecondaryButton {
                        label: "Toggle Favorite";

                        clicked => {
                            root.toggle-favorite();
                        }
                    }

                    playlist-picker := ComboBox {
                        model: root.playlists;
                        enabled: root.playlists.length > 0;
                    }

                    SecondaryButton {
                        label: "Add to Playlist";

                        enabled: root.playlists.length > 0
                            && playlist-picker.current-value != "";

                        clicked => {
                            root.add-to-playlist(
                                playlist-picker.current-value);
                        }
                    }
                }

                if root.library-status != "": Text {
                    text: root.library-status;
                    color: #aaaaaa;
                    font-size: 14px;
                    wrap: word-wrap;
                }
            }
        }
    }
}
