import {
    Button,
    Slider,
    VerticalBox,
    HorizontalBox,
    ComboBox,
} from "std-widgets.slint";

export component WatchPage inherits Rectangle {

    in property <string> video-title;
    in property <string> channel;
    in property <string> video-id;

    in property <[string]> playlists;
    in property <string> library-status: "";

    in property <bool> player-ready: false;
    in property <bool> player-paused: true;

    in property <float> playback-position: 0;
    in property <float> playback-duration: 0;
    in property <float> playback-volume: 70;

    in property <bool> fullscreen-mode: false;
    in property <string> playback-state: "idle";

    out property <length> video-surface-x:
        video-surface.absolute-position.x;

    out property <length> video-surface-y:
        video-surface.absolute-position.y;

    out property <length> video-surface-width:
        video-surface.width;

    out property <length> video-surface-height:
        video-surface.height;

    callback back();
    callback play(string);

    callback toggle-favorite();
    callback add-to-playlist(string);

    callback toggle-playback();
    callback stop-playback();

    callback seek-playback(float);
    callback change-volume(float);

    callback replay();
    callback toggle-fullscreen();

    background: #0f0f0f;

    VerticalBox {
        padding: root.fullscreen-mode ? 0px : 20px;
        spacing: root.fullscreen-mode ? 4px : 16px;

        if !root.fullscreen-mode: HorizontalBox {
            spacing: 12px;

            Button {
                text: "← Back";

                clicked => {
                    root.back();
                }
            }

            Text {
                text: "MutsukiTube";
                color: white;
                font-size: 22px;
                font-weight: 700;
                vertical-alignment: center;
            }

            Rectangle {
                horizontal-stretch: 1;
                background: transparent;
            }
        }

        video-surface := Rectangle {
            min-height: root.fullscreen-mode ? 0px : 360px;
            max-height: root.fullscreen-mode ? 10000px : 360px;

            horizontal-stretch: 1;
            vertical-stretch: root.fullscreen-mode ? 1 : 0;

            background: #050505;
            border-radius: root.fullscreen-mode ? 0px : 8px;

            Text {
                text: root.player-ready ? "" : "Video Player";
                color: #777777;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        if !root.fullscreen-mode: HorizontalBox {
            spacing: 12px;

            Button {
                text: "Play Video";
                enabled: root.video-id != "";

                clicked => {
                    root.play(root.video-id);
                }
            }

            Text {
                text: root.player-ready
                    ? "Embedded libmpv ready"
                    : "Initializing player...";

                color: #aaaaaa;
                vertical-alignment: center;
            }

            Rectangle {
                horizontal-stretch: 1;
                background: transparent;
            }
        }

        Text {
            text: root.playback-state == "finished"
                ? "Video selesai diputar"
                : root.playback-state == "loading"
                ? "Loading video..."
                : root.playback-state == "error"
                ? "Video gagal diputar"
                : "";

            color: #aaaaaa;
            font-size: 14px;
            visible: self.text != "";
        }

        VerticalBox {
            spacing: 6px;

            seek-slider := Slider {
                minimum: 0;

                maximum: root.playback-duration > 0
                    ? root.playback-duration
                    : 1;

                value: root.playback-position;

                enabled: root.player-ready
                    && root.playback-duration > 0;

                released(value) => {
                    root.seek-playback(value);
                }
            }

            HorizontalBox {
                spacing: 8px;

                Text {
                    text: root.playback-position.to-fixed(0) + "s";
                    color: #aaaaaa;
                    font-size: 13px;
                }

                Rectangle {
                    horizontal-stretch: 1;
                    background: transparent;
                }

                Text {
                    text: root.playback-duration.to-fixed(0) + "s";
                    color: #aaaaaa;
                    font-size: 13px;
                }
            }
        }

        HorizontalBox {
            spacing: 12px;

            Button {
                text: root.player-paused
                    ? "▶ Play"
                    : "⏸ Pause";

                enabled: root.player-ready;

                clicked => {
                    root.toggle-playback();
                }
            }

            Button {
                text: "■ Stop";
                enabled: root.player-ready;

                clicked => {
                    root.stop-playback();
                }
            }

            Button {
                text: "↻ Replay";

                enabled: root.playback-state == "finished"
                    && root.video-id != "";

                clicked => {
                    root.replay();
                }
            }

            Button {
                text: root.fullscreen-mode
                    ? "⤢ Exit Fullscreen"
                    : "⛶ Fullscreen";

                enabled: root.player-ready;

                clicked => {
                    root.toggle-fullscreen();
                }
            }

            Rectangle {
                horizontal-stretch: 1;
                background: transparent;
            }

            Text {
                text: "Volume";
                color: white;
                vertical-alignment: center;
            }

            Slider {
                minimum: 0;
                maximum: 100;
                step: 1;

                value: root.playback-volume;
                enabled: root.player-ready;

                horizontal-stretch: 1;

                changed(value) => {
                    root.change-volume(value);
                }
            }

            Text {
                text: root.playback-volume.to-fixed(0)
                    + "%";

                color: #aaaaaa;
                vertical-alignment: center;
            }
        }

        if !root.fullscreen-mode: Text {
            text: root.video-title;
            color: white;
            font-size: 23px;
            font-weight: 700;
            wrap: word-wrap;
        }

        if !root.fullscreen-mode: Text {
            text: root.channel;
            color: #aaaaaa;
            font-size: 16px;
        }

        if !root.fullscreen-mode: HorizontalBox {
            spacing: 12px;

            Button {
                text: "Toggle Favorite";

                clicked => {
                    root.toggle-favorite();
                }
            }

            playlist-picker := ComboBox {
                model: root.playlists;
                enabled: root.playlists.length > 0;
            }

            Button {
                text: "Add to Playlist";

                enabled: root.playlists.length > 0
                    && playlist-picker.current-value != "";

                clicked => {
                    root.add-to-playlist(
                        playlist-picker.current-value);
                }
            }
        }

        if !root.fullscreen-mode && root.library-status != "": Text {
            text: root.library-status;
            color: #aaaaaa;
            font-size: 14px;
            wrap: word-wrap;
        }

        if !root.fullscreen-mode: Rectangle {
            vertical-stretch: 1;
            background: transparent;
        }
    }
}
