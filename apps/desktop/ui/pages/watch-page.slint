import {
    Button,
    VerticalBox,
    HorizontalBox,
    ComboBox,
} from "std-widgets.slint";

export component WatchPage inherits Rectangle {
    in property <string> video-title;
    in property <string> channel;
    in property <string> video-id;

    in property <[string]> playlists;
    in property <string> library-status: "";

    callback back();
    callback play(string);
    callback toggle-favorite();
    callback add-to-playlist(string);

    background: #0f0f0f;

    VerticalBox {
        padding: 20px;
        spacing: 16px;

        HorizontalBox {
            spacing: 12px;

            Button {
                text: "← Back";

                clicked => {
                    root.back();
                }
            }

            Text {
                text: "MutsukiTube";
                color: white;
                font-size: 22px;
                font-weight: 700;
            }
        }

        Rectangle {
            height: 430px;
            background: #050505;
            border-radius: 10px;

            VerticalLayout {
                alignment: center;
                spacing: 20px;

                Text {
                    text: "Video Player";
                    horizontal-alignment: center;
                    color: #777777;
                    font-size: 28px;
                }

                Button {
                    text: "Play with mpv";

                    clicked => {
                        root.play(root.video-id);
                    }
                }
            }
        }

        Text {
            text: root.video-title;
            color: white;
            font-size: 23px;
            font-weight: 700;
            wrap: word-wrap;
        }

        Text {
            text: root.channel;
            color: #aaaaaa;
            font-size: 16px;
        }

        HorizontalBox {
            spacing: 12px;

            Button {
                text: "Toggle Favorite";

                clicked => {
                    root.toggle-favorite();
                }
            }

            playlist-picker := ComboBox {
                model: root.playlists;
                enabled: root.playlists.length > 0;
            }

            Button {
                text: "Add to Playlist";

                enabled: root.playlists.length > 0
                    && playlist-picker.current-value != "";

                clicked => {
                    root.add-to-playlist(
                        playlist-picker.current-value);
                }
            }
        }

        if root.library-status != "": Text {
            text: root.library-status;
            color: #aaaaaa;
            font-size: 14px;
            wrap: word-wrap;
        }

        Rectangle {
            vertical-stretch: 1;
            background: transparent;
        }
    }
}
