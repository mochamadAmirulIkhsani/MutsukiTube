import {
    Button,
    ComboBox,
    LineEdit,
    ListView,
    ScrollView,
    Spinner,
} from "std-widgets.slint";

import { Theme } from "../theme.slint";
import { AnimeCard } from "../components/anime-poster-card.slint";
import { EpisodeItem, EpisodeRow } from "../components/episode-row.slint";
import { PosterShelf } from "../components/poster-shelf.slint";

export component AnimePage inherits Rectangle {
    // "home" | "details" | "setup"
    in property <string> view: "home";
    in property <bool> plugins-ready: false;

    in property <string> status-text: "";
    in property <string> status-kind: "info";
    in property <bool> loading: false;

    // Home shelves
    in property <[AnimeCard]> continue-cards;
    in property <[AnimeCard]> recent-cards;
    in property <[AnimeCard]> favorite-cards;
    in property <[AnimeCard]> result-cards;
    in property <string> results-heading: "";
    in property <string> selected-key: "";

    // Details
    in property <string> detail-title: "";
    in property <string> detail-subtitle: "";
    in property <string> detail-description: "";
    in property <string> detail-badge: "";
    in property <image> detail-poster;
    in property <bool> detail-has-poster: false;
    in property <bool> detail-favorite: false;
    in property <string> detail-loading-text: "";
    in property <int> selected-episode-number: -1;
    in property <string> resume-label: "";
    in property <[EpisodeItem]> episodes;

    in property <[string]> qualities: ["Auto"];
    in-out property <string> selected-quality: "Auto";

    callback search(string);
    callback select-anime(string);
    callback select-episode(int);
    callback play();
    callback resume();
    callback toggle-favorite();
    callback back();
    callback install-plugins();

    background: Theme.bg;

    function status-color() -> color {
        if (root.status-kind == "error") {
            return Theme.danger;
        }
        if (root.status-kind == "offline") {
            return #e0a458;
        }
        return Theme.text-secondary;
    }

    VerticalLayout {
        spacing: 0px;

        // ------------------------------------------------------------- Top Bar
        Rectangle {
            height: 68px;
            background: Theme.bg;

            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                width: 100%;
                background: Theme.border;
            }

            HorizontalLayout {
                padding-left: 24px;
                padding-right: 24px;
                spacing: 16px;
                alignment: space-between;
                cross-axis-alignment: center;

                // Left Navigation & Heading
                HorizontalLayout {
                    spacing: 14px;
                    alignment: start;
                    cross-axis-alignment: center;

                    Button {
                        text: "‹ Back";
                        clicked => { root.back(); }
                    }

                    VerticalLayout {
                        spacing: 2px;
                        alignment: center;

                        Text {
                            text: root.view == "details" ? "Anime Details" : "Anime";
                            color: Theme.text-primary;
                            font-size: 20px;
                            font-weight: 700;
                        }

                        Text {
                            text: root.view == "details"
                                ? (root.detail-title != "" ? root.detail-title : "Episodes and stream quality")
                                : "Browse and stream anime series with provider plugins";
                            color: Theme.text-secondary;
                            font-size: 12px;
                            max-lines: 1;
                            overflow: elide;
                        }
                    }
                }

                // Search Bar
                HorizontalLayout {
                    spacing: 8px;
                    cross-axis-alignment: center;

                    search-box := LineEdit {
                        placeholder-text: "Search anime titles...";
                        min-width: 260px;
                        enabled: !root.loading;
                        accepted => { root.search(search-box.text); }
                    }

                    Button {
                        text: "Search";
                        primary: true;
                        enabled: !root.loading && search-box.text != "";
                        clicked => { root.search(search-box.text); }
                    }
                }
            }
        }

        // ---------------------------------------------------------- Status Bar
        if root.loading || root.status-text != "": Rectangle {
            height: 32px;
            background: Theme.surface-sunken;

            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                width: 100%;
                background: Theme.border;
            }

            HorizontalLayout {
                padding-left: 24px;
                padding-right: 24px;
                spacing: 10px;
                alignment: start;
                cross-axis-alignment: center;

                if root.loading: Spinner {
                    width: 14px;
                    height: 14px;
                }

                Text {
                    text: root.loading ? "Working..." : root.status-text;
                    color: root.status-color();
                    font-size: 12px;
                    vertical-alignment: center;
                }
            }
        }

        // ---------------------------------------------------------------- Setup
        if root.view == "setup": Rectangle {
            vertical-stretch: 1;
            background: Theme.bg;

            VerticalLayout {
                alignment: center;
                cross-axis-alignment: center;
                padding: 40px;

                Rectangle {
                    width: 520px;
                    border-radius: 12px;
                    background: Theme.surface-elevated;
                    border-width: 1px;
                    border-color: Theme.border;

                    VerticalLayout {
                        padding: 36px;
                        spacing: 18px;
                        alignment: center;
                        cross-axis-alignment: center;

                        Image {
                            source: @image-url("../assets/anime.svg");
                            width: 48px;
                            height: 48px;
                        }

                        Text {
                            text: "Anime Plugins Required";
                            color: Theme.text-primary;
                            font-size: 20px;
                            font-weight: 700;
                            horizontal-alignment: center;
                        }

                        Text {
                            text: "MutsukiTube installs cryptographically signed provider plugins to browse anime catalogs, search titles, and fetch high-definition video sources with subtitle streams.";
                            color: Theme.text-secondary;
                            font-size: 13px;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }

                        Rectangle {
                            height: 6px;
                        }

                        Button {
                            text: "Install Anime Plugins";
                            primary: true;
                            enabled: !root.loading;
                            clicked => { root.install-plugins(); }
                        }

                        Text {
                            text: "Runs locally on your device with sandboxed provider execution";
                            color: Theme.text-muted;
                            font-size: 11px;
                            horizontal-alignment: center;
                        }
                    }
                }
            }
        }

        // -------------------------------------------------------------- Details
        if root.view == "details": VerticalLayout {
            vertical-stretch: 1;
            spacing: 0px;

            // Hero Section
            Rectangle {
                height: 290px;
                background: Theme.surface-elevated;

                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    width: 100%;
                    background: Theme.border;
                }

                HorizontalLayout {
                    padding: 24px;
                    spacing: 24px;
                    alignment: start;

                    // Poster
                    Rectangle {
                        width: 160px;
                        height: 240px;
                        border-radius: Theme.radius;
                        clip: true;
                        background: Theme.surface;
                        border-width: 1px;
                        border-color: Theme.border;

                        Image {
                            source: root.detail-poster;
                            width: 100%;
                            height: 100%;
                            image-fit: cover;
                        }

                        if !root.detail-has-poster: VerticalLayout {
                            padding: 16px;
                            alignment: center;

                            Text {
                                text: root.detail-title;
                                color: Theme.text-muted;
                                font-size: 14px;
                                wrap: word-wrap;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // Metadata and Controls
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 12px;

                        Text {
                            text: root.detail-title;
                            color: Theme.text-primary;
                            font-size: 26px;
                            font-weight: 700;
                            wrap: word-wrap;
                            max-lines: 2;
                            overflow: elide;
                        }

                        // Badges & Subtitle Row
                        HorizontalLayout {
                            spacing: 10px;
                            alignment: start;
                            cross-axis-alignment: center;

                            if root.detail-badge != "": Rectangle {
                                height: 22px;
                                border-radius: 4px;
                                background: Theme.accent-soft;
                                border-width: 1px;
                                border-color: Theme.accent;

                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    alignment: center;
                                    cross-axis-alignment: center;

                                    Text {
                                        text: root.detail-badge;
                                        color: Theme.accent;
                                        font-size: 11px;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            if root.detail-subtitle != "": Text {
                                text: root.detail-subtitle;
                                color: Theme.text-secondary;
                                font-size: 13px;
                                vertical-alignment: center;
                            }
                        }

                        // Actions Row
                        HorizontalLayout {
                            spacing: 10px;
                            alignment: start;
                            cross-axis-alignment: center;

                            Button {
                                text: root.resume-label != "" ? root.resume-label : "▶ Play Episode";
                                primary: true;
                                enabled: root.selected-episode-number > 0;
                                clicked => {
                                    if (root.resume-label != "") {
                                        root.resume();
                                    } else {
                                        root.play();
                                    }
                                }
                            }

                            Button {
                                text: root.detail-favorite ? "★ Favorited" : "☆ Add to Favorites";
                                clicked => { root.toggle-favorite(); }
                            }

                            if root.qualities.length > 1: HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                cross-axis-alignment: center;

                                Text {
                                    text: "Quality:";
                                    color: Theme.text-secondary;
                                    font-size: 13px;
                                    vertical-alignment: center;
                                }

                                ComboBox {
                                    model: root.qualities;
                                    current-value: root.selected-quality;
                                    min-width: 100px;
                                    selected(value) => {
                                        root.selected-quality = value;
                                    }
                                }
                            }
                        }

                        // Description
                        if root.detail-description != "": Text {
                            text: root.detail-description;
                            color: Theme.text-secondary;
                            font-size: 13px;
                            wrap: word-wrap;
                            max-lines: 3;
                            overflow: elide;
                        }
                    }
                }
            }

            // Episodes Section
            VerticalLayout {
                vertical-stretch: 1;
                spacing: 12px;
                padding-left: 24px;
                padding-right: 24px;
                padding-top: 18px;
                padding-bottom: 18px;

                HorizontalLayout {
                    spacing: 10px;
                    alignment: space-between;
                    cross-axis-alignment: center;

                    HorizontalLayout {
                        spacing: 10px;
                        alignment: start;
                        cross-axis-alignment: center;

                        Rectangle {
                            width: 3px;
                            height: 18px;
                            border-radius: 2px;
                            background: Theme.accent;
                        }

                        Text {
                            text: "Episodes";
                            color: Theme.text-primary;
                            font-size: 18px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }

                        if root.episodes.length > 0: Rectangle {
                            height: 20px;
                            border-radius: 10px;
                            background: Theme.surface-elevated;
                            border-width: 1px;
                            border-color: Theme.border;

                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                alignment: center;
                                cross-axis-alignment: center;

                                Text {
                                    text: root.episodes.length;
                                    font-size: 11px;
                                    font-weight: 600;
                                    color: Theme.text-secondary;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    if root.detail-loading-text != "": Text {
                        text: root.detail-loading-text;
                        color: Theme.text-muted;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                }

                // Virtualized Episode List
                episode-list := ListView {
                    for episode in root.episodes: Rectangle {
                        height: 92px;
                        width: episode-list.width - 14px;
                        background: transparent;

                        EpisodeRow {
                            width: 100%;
                            height: 84px;
                            y: 4px;
                            item: episode;
                            selected: episode.number == root.selected-episode-number;
                            clicked(number) => { root.select-episode(number); }
                        }
                    }
                }
            }
        }

        // ----------------------------------------------------------------- Home
        if root.view == "home": ScrollView {
            vertical-stretch: 1;

            VerticalLayout {
                padding: 24px;
                spacing: 28px;

                if root.result-cards.length > 0: PosterShelf {
                    heading: root.results-heading != "" ? root.results-heading : "Results";
                    cards: root.result-cards;
                    selected-key: root.selected-key;
                    activated(key) => { root.select-anime(key); }
                }

                if root.continue-cards.length > 0: PosterShelf {
                    heading: "Continue Watching";
                    cards: root.continue-cards;
                    selected-key: root.selected-key;
                    activated(key) => { root.select-anime(key); }
                }

                if root.recent-cards.length > 0: PosterShelf {
                    heading: "Recently Watched";
                    cards: root.recent-cards;
                    selected-key: root.selected-key;
                    activated(key) => { root.select-anime(key); }
                }

                if root.favorite-cards.length > 0: PosterShelf {
                    heading: "My Anime";
                    cards: root.favorite-cards;
                    selected-key: root.selected-key;
                    activated(key) => { root.select-anime(key); }
                }

                // Clean Cupertino Empty Onboarding State
                if root.result-cards.length == 0
                    && root.continue-cards.length == 0
                    && root.recent-cards.length == 0
                    && root.favorite-cards.length == 0: Rectangle {
                    background: transparent;
                    height: 380px;

                    VerticalLayout {
                        alignment: center;
                        cross-axis-alignment: center;
                        spacing: 16px;

                        Rectangle {
                            width: 520px;
                            border-radius: 12px;
                            background: Theme.surface-elevated;
                            border-width: 1px;
                            border-color: Theme.border;

                            VerticalLayout {
                                padding: 36px;
                                spacing: 14px;
                                alignment: center;
                                cross-axis-alignment: center;

                                Image {
                                    source: @image-url("../assets/anime.svg");
                                    width: 44px;
                                    height: 44px;
                                }

                                Text {
                                    text: "Discover Anime";
                                    color: Theme.text-primary;
                                    font-size: 20px;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                }

                                Text {
                                    text: "Search for any anime title using the search bar above to stream episodes in high quality. In-progress watching history and bookmarked series will appear here.";
                                    color: Theme.text-secondary;
                                    font-size: 13px;
                                    horizontal-alignment: center;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
