import {
    Button,
    LineEdit,
    VerticalBox,
    HorizontalBox,
    ScrollView,
    Spinner,
} from "std-widgets.slint";

import {
    VideoCard,
    VideoItem,
} from "../components/video-card.slint";
import { Theme } from "../theme.slint";

export component SearchPage inherits Rectangle {
    in property <[VideoItem]> videos;
    in property <bool> loading: false;
    in property <bool> loading-more: false;
    in property <bool> has-more: false;
    in property <string> status-text: "";
    in-out property <string> search-query: "";

    callback search(string);
    callback back();
    callback open-video(string);
    callback load-more();
    callback show-history();
    callback show-settings();
    callback show-library();
    callback show-anime();

    background: Theme.bg;

    VerticalBox {
        padding: 20px;
        spacing: 16px;

        // Clean Cupertino Search Header
        HorizontalBox {
            spacing: 12px;
            alignment: center;

            Button {
                text: "‹ Back";
                clicked => {
                    root.back();
                }
            }

            search-box := LineEdit {
                placeholder-text: "Search YouTube...";
                text <=> root.search-query;
                horizontal-stretch: 1;

                accepted => {
                    root.search(search-box.text);
                }
            }

            Button {
                text: "Search";
                primary: true;
                enabled: !root.loading && search-box.text != "";

                clicked => {
                    root.search(search-box.text);
                }
            }
        }

        if root.loading: HorizontalBox {
            spacing: 10px;
            alignment: start;

            Spinner {
                width: 18px;
                height: 18px;
            }

            Text {
                text: "Searching...";
                color: Theme.text-secondary;
                font-size: 13px;
                vertical-alignment: center;
            }
        }

        if root.status-text != "": Text {
            text: root.status-text;
            color: Theme.text-muted;
            font-size: 13px;
        }

        ScrollView {
            horizontal-stretch: 1;
            vertical-stretch: 1;

            VerticalLayout {
                spacing: 10px;
                padding-bottom: 20px;

                for video in root.videos: VideoCard {
                    video: video;

                    clicked(id) => {
                        root.open-video(id);
                    }
                }

                if root.has-more: HorizontalBox {
                    alignment: center;
                    padding-top: 10px;

                    Button {
                        text: root.loading-more
                            ? "Loading more..."
                            : "Load More Videos";

                        enabled: !root.loading-more && !root.loading;

                        clicked => {
                            root.load-more();
                        }
                    }
                }
            }
        }
    }
}
