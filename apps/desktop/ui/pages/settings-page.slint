import {
    Button,
    ComboBox,
    VerticalBox,
    HorizontalBox,
} from "std-widgets.slint";
import { Theme } from "../theme.slint";

export component SettingsPage inherits Rectangle {
    in property <string> provider-mode: "auto";
    in property <string> status-text: "";

    callback back();
    callback save-provider(string);

    background: Theme.bg;

    VerticalBox {
        padding: 24px;
        spacing: 20px;

        // Header
        HorizontalBox {
            spacing: 12px;
            alignment: center;

            Button {
                text: "‹ Back";
                clicked => {
                    root.back();
                }
            }

            Text {
                text: "Settings";
                color: Theme.text-primary;
                font-size: 20px;
                font-weight: 700;
                vertical-alignment: center;
            }

            Rectangle {
                horizontal-stretch: 1;
                background: transparent;
            }
        }

        // Cupertino Grouped Settings Card
        Rectangle {
            background: Theme.surface;
            border-radius: Theme.radius;
            border-width: 1px;
            border-color: Theme.border;

            VerticalBox {
                padding: 16px;
                spacing: 14px;

                Text {
                    text: "YouTube Search Provider";
                    color: Theme.text-primary;
                    font-size: 15px;
                    font-weight: 600;
                }

                HorizontalBox {
                    spacing: 12px;
                    alignment: center;

                    provider-select := ComboBox {
                        model: ["auto", "native", "ytdlp"];
                        current-value: root.provider-mode;
                        min-width: 140px;
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                        background: transparent;
                    }

                    Button {
                        text: "Save";
                        primary: true;
                        clicked => {
                            root.save-provider(provider-select.current-value);
                        }
                    }
                }

                Rectangle {
                    height: 1px;
                    background: Theme.border;
                }

                VerticalLayout {
                    spacing: 4px;

                    Text {
                        text: "• Auto: Native InnerTube first, yt-dlp fallback if blocked.";
                        color: Theme.text-secondary;
                        font-size: 13px;
                    }

                    Text {
                        text: "• Native: Fast Rust InnerTube client only (no external python needed).";
                        color: Theme.text-secondary;
                        font-size: 13px;
                    }

                    Text {
                        text: "• yt-dlp: Robust external extractor backend.";
                        color: Theme.text-secondary;
                        font-size: 13px;
                    }
                }
            }
        }

        if root.status-text != "": HorizontalBox {
            alignment: start;

            Text {
                text: root.status-text;
                color: Theme.success;
                font-size: 13px;
                font-weight: 500;
            }
        }

        Rectangle {
            vertical-stretch: 1;
            background: transparent;
        }
    }
}
