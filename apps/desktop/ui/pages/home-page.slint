import {
    Button,
    LineEdit,
    ScrollView,
    Spinner,
    VerticalBox,
    HorizontalBox,
} from "std-widgets.slint";

import { VideoCard, GridVideoCard, VideoItem, ChannelItem } from "../components/video-card.slint";
import { Theme } from "../theme.slint";

component SubscribedChannelChip inherits Rectangle {
    in property <ChannelItem> channel;
    callback clicked();

    height: 38px;
    border-radius: 19px;
    background: touch.has-hover ? Theme.surface-hover : Theme.surface;
    border-width: 1px;
    border-color: touch.has-hover ? Theme.border-strong : Theme.border;

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 5px;
        padding-right: 14px;
        spacing: 9px;
        alignment: center;
        cross-axis-alignment: center;

        Rectangle {
            width: 28px;
            height: 28px;
            border-radius: 14px;
            clip: true;
            background: Theme.accent-soft;

            if !root.channel.has-avatar: Text {
                text: root.channel.initials;
                font-size: 12px;
                font-weight: 700;
                color: Theme.accent;
                vertical-alignment: center;
                horizontal-alignment: center;
            }

            if root.channel.has-avatar: Image {
                source: root.channel.avatar;
                width: 100%;
                height: 100%;
            }
        }

        Text {
            text: root.channel.title;
            font-size: 13px;
            font-weight: 500;
            color: touch.has-hover ? Theme.text-primary : Theme.text-secondary;
            vertical-alignment: center;
            overflow: elide;
            max-width: 150px;
        }
    }
}

component TopicPill inherits Rectangle {
    in property <string> label: "";
    in property <bool> active: false;
    callback clicked();

    height: 32px;
    border-radius: 16px;

    background: root.active
        ? Theme.accent
        : (touch.has-hover ? Theme.surface-hover : Theme.surface);

    border-width: 1px;
    border-color: root.active
        ? Theme.accent
        : (touch.has-hover ? Theme.border-strong : Theme.border);

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        alignment: center;
        cross-axis-alignment: center;

        Text {
            text: root.label;
            font-size: 13px;
            font-weight: root.active ? 600 : 500;
            color: root.active ? #ffffff : (touch.has-hover ? Theme.text-primary : Theme.text-secondary);
            vertical-alignment: center;
        }
    }
}

export component HomePage inherits Rectangle {
    in property <[VideoItem]> videos;
    in property <[VideoItem]> continue-videos;
    in property <[VideoItem]> favorite-videos;
    in property <[ChannelItem]> subscribed-channels;
    in property <[string]> playlist-names;

    in property <bool> home-loading: false;
    in property <string> home-status-text: "";
    in property <string> selected-topic: "";
    in property <bool> load-more-enabled: false;

    callback search(string);
    callback open-video(string);
    callback show-history();
    callback show-settings();
    callback show-library();
    callback show-favorites();
    callback show-anime();
    callback show-subscriptions();
    callback select-channel(string, string);
    callback select-topic(string);
    callback load-more();

    background: Theme.bg;

    VerticalLayout {
        spacing: 0px;

        // ------------------------------------------------------------- Top Bar
        Rectangle {
            height: 68px;
            background: Theme.bg;

            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                width: 100%;
                background: Theme.border;
            }

            HorizontalLayout {
                padding-left: 24px;
                padding-right: 24px;
                spacing: 16px;
                alignment: space-between;
                cross-axis-alignment: center;

                // Page Heading
                VerticalLayout {
                    spacing: 2px;
                    alignment: center;

                    Text {
                        text: "Explore";
                        color: Theme.text-primary;
                        font-size: 20px;
                        font-weight: 700;
                    }

                    Text {
                        text: "Watch trending videos and community favorites";
                        color: Theme.text-secondary;
                        font-size: 12px;
                    }
                }

                // Integrated Search Box
                HorizontalLayout {
                    spacing: 8px;
                    cross-axis-alignment: center;

                    search-box := LineEdit {
                        placeholder-text: "Search YouTube...";
                        min-width: 280px;

                        accepted => {
                            root.search(search-box.text);
                        }
                    }

                    Button {
                        text: "Search";
                        primary: true;
                        enabled: !root.home-loading && search-box.text != "";
                        clicked => {
                            root.search(search-box.text);
                        }
                    }
                }
            }
        }

        // ---------------------------------------------------------- Status Bar
        if root.home-loading || root.home-status-text != "": Rectangle {
            height: 32px;
            background: Theme.surface-sunken;

            HorizontalLayout {
                padding-left: 24px;
                padding-right: 24px;
                spacing: 10px;
                alignment: start;
                cross-axis-alignment: center;

                if root.home-loading: Spinner {
                    width: 14px;
                    height: 14px;
                }

                Text {
                    text: root.home-loading ? "Loading..." : root.home-status-text;
                    color: Theme.text-secondary;
                    font-size: 13px;
                    vertical-alignment: center;
                }
            }
        }

        // ---------------------------------------------------- Main Scroll Area
        ScrollView {
            vertical-stretch: 1;
            horizontal-scrollbar-policy: always-off;
            vertical-scrollbar-policy: as-needed;

            VerticalLayout {
                padding: 24px;
                spacing: 28px;

                // ---------------------------------------- Topic Segmented Pills
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    cross-axis-alignment: center;

                    TopicPill {
                        label: "All";
                        active: root.selected-topic == "";
                        clicked => { root.select-topic(""); }
                    }

                    TopicPill {
                        label: "Music";
                        active: root.selected-topic == "Music";
                        clicked => { root.select-topic("Music"); }
                    }

                    TopicPill {
                        label: "Gaming";
                        active: root.selected-topic == "Gaming";
                        clicked => { root.select-topic("Gaming"); }
                    }

                    TopicPill {
                        label: "Technology";
                        active: root.selected-topic == "Technology";
                        clicked => { root.select-topic("Technology"); }
                    }

                    TopicPill {
                        label: "Podcasts";
                        active: root.selected-topic == "Podcasts";
                        clicked => { root.select-topic("Podcasts"); }
                    }

                    TopicPill {
                        label: "Education";
                        active: root.selected-topic == "Education";
                        clicked => { root.select-topic("Education"); }
                    }
                }

                // ---------------------------------------- Subscribed Channels Shelf
                if root.subscribed-channels.length > 0: VerticalLayout {
                    spacing: 12px;

                    HorizontalLayout {
                        spacing: 8px;
                        cross-axis-alignment: center;

                        Rectangle {
                            width: 3px;
                            height: 16px;
                            border-radius: 1.5px;
                            background: Theme.accent;
                        }

                        Text {
                            text: "Your Subscriptions";
                            color: Theme.text-primary;
                            font-size: 18px;
                            font-weight: 700;
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                            background: transparent;
                        }

                        Button {
                            text: "View All (" + root.subscribed-channels.length + ") ›";
                            clicked => {
                                root.show-subscriptions();
                            }
                        }
                    }

                    ScrollView {
                        horizontal-stretch: 1;
                        height: 52px;
                        horizontal-scrollbar-policy: as-needed;
                        vertical-scrollbar-policy: always-off;

                        HorizontalLayout {
                            spacing: 10px;
                            padding-top: 2px;
                            padding-bottom: 6px;

                            for channel in root.subscribed-channels: SubscribedChannelChip {
                                channel: channel;
                                clicked => {
                                    root.select-channel(channel.id, channel.title);
                                }
                            }
                        }
                    }
                }

                // -------------------------------------------- Continue Watching
                if root.continue-videos.length > 0: VerticalLayout {
                    spacing: 12px;

                    HorizontalLayout {
                        spacing: 8px;
                        cross-axis-alignment: center;

                        Rectangle {
                            width: 3px;
                            height: 16px;
                            border-radius: 1.5px;
                            background: Theme.accent;
                        }

                        Text {
                            text: "Continue Watching";
                            color: Theme.text-primary;
                            font-size: 18px;
                            font-weight: 700;
                        }
                    }

                    ScrollView {
                        horizontal-stretch: 1;
                        height: 232px;
                        horizontal-scrollbar-policy: as-needed;
                        vertical-scrollbar-policy: always-off;

                        HorizontalLayout {
                            spacing: 16px;
                            padding-top: 2px;
                            padding-bottom: 6px;

                            for video in root.continue-videos: GridVideoCard {
                                video: video;
                                clicked(id) => {
                                    root.open-video(id);
                                }
                            }
                        }
                    }
                }

                // ---------------------------------------------------- Favorites
                if root.favorite-videos.length > 0: VerticalLayout {
                    spacing: 12px;

                    HorizontalLayout {
                        spacing: 8px;
                        cross-axis-alignment: center;

                        Rectangle {
                            width: 3px;
                            height: 16px;
                            border-radius: 1.5px;
                            background: Theme.accent;
                        }

                        Text {
                            text: "Favorites";
                            color: Theme.text-primary;
                            font-size: 18px;
                            font-weight: 700;
                        }
                    }

                    ScrollView {
                        horizontal-stretch: 1;
                        height: 232px;
                        horizontal-scrollbar-policy: as-needed;
                        vertical-scrollbar-policy: always-off;

                        HorizontalLayout {
                            spacing: 16px;
                            padding-top: 2px;
                            padding-bottom: 6px;

                            for video in root.favorite-videos: GridVideoCard {
                                video: video;
                                clicked(id) => {
                                    root.open-video(id);
                                }
                            }
                        }
                    }
                }

                // ---------------------------------------- Explore Grid Section
                VerticalLayout {
                    spacing: 14px;

                    HorizontalLayout {
                        spacing: 8px;
                        cross-axis-alignment: center;

                        Rectangle {
                            width: 3px;
                            height: 16px;
                            border-radius: 1.5px;
                            background: Theme.accent;
                        }

                        Text {
                            text: root.selected-topic == ""
                                ? "Explore Feed"
                                : ("Explore · " + root.selected-topic);
                            color: Theme.text-primary;
                            font-size: 18px;
                            font-weight: 700;
                        }
                    }

                    if root.home-status-text != "" && root.videos.length == 0: Text {
                        text: root.home-status-text;
                        color: Theme.text-secondary;
                        font-size: 14px;
                    }

                    // Responsive Grid Feed of 16:9 Video Cards
                    if root.videos.length > 0: FlexboxLayout {
                        spacing: 18px;
                        flex-direction: row;
                        flex-wrap: wrap;
                        alignment: start;

                        for video in root.videos: GridVideoCard {
                            video: video;
                            clicked(id) => {
                                root.open-video(id);
                            }
                        }
                    }

                    // Load More Action
                    if root.load-more-enabled: HorizontalLayout {
                        alignment: center;
                        padding-top: 12px;
                        padding-bottom: 24px;

                        Button {
                            text: "Load More Videos";
                            clicked => {
                                root.load-more();
                            }
                        }
                    }
                }

                // ------------------------------------------------- Empty State
                if root.continue-videos.length == 0
                    && root.favorite-videos.length == 0
                    && root.videos.length == 0
                    && !root.home-loading: Rectangle {
                    background: transparent;
                    height: 320px;

                    VerticalLayout {
                        alignment: center;
                        cross-axis-alignment: center;
                        spacing: 14px;

                        Text {
                            text: "Welcome to MutsukiTube";
                            color: Theme.text-primary;
                            font-size: 22px;
                            font-weight: 700;
                            horizontal-alignment: center;
                        }

                        Text {
                            text: "Select a topic above or search for a video to start streaming.";
                            color: Theme.text-secondary;
                            font-size: 14px;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }

                        HorizontalLayout {
                            spacing: 10px;
                            alignment: center;
                            padding-top: 6px;

                            Button {
                                text: "Browse Music";
                                clicked => { root.select-topic("Music"); }
                            }

                            Button {
                                text: "Browse Gaming";
                                clicked => { root.select-topic("Gaming"); }
                            }
                        }
                    }
                }
            }
        }
    }
}
