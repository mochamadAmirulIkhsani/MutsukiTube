import {
    HomePage,
} from "pages/home-page.slint";
import {
    TrendingPage,
} from "pages/trending-page.slint";
import {
    SearchPage,
} from "pages/search-page.slint";
import {
    WatchPage,
} from "pages/watch-page.slint";
import {
    AnimePage,
} from "pages/anime-page.slint";
import {
    AnimeCard,
} from "components/anime-poster-card.slint";
import {
    EpisodeItem,
} from "components/episode-row.slint";
import {
    VideoItem,
    ChannelItem,
} from "components/video-card.slint";
import {
    SubscriptionsPage,
} from "pages/subscriptions-page.slint";
import {
    HistoryPage,
} from "pages/history-page.slint";
import {
    SettingsPage,
} from "pages/settings-page.slint";
import {
    LibraryPage,
} from "pages/library-page.slint";
import { Sidebar } from "components/sidebar.slint";
import { FloatingPip } from "components/floating-pip.slint";
import { Theme } from "theme.slint";

export component AppWindow inherits Window {
    title: "MutsukiTube";
    icon: @image-url("assets/favicon.ico");

    preferred-width: 1200px;
    preferred-height: 760px;

    min-width: 800px;
    min-height: 600px;
    background: Theme.bg;

    // Responsive / Adaptive Sidebar state
    in-out property <bool> user-collapsed: false;
    in-out property <bool> is-sidebar-collapsed: false;

    changed width => {
        if (!root.user-collapsed) {
            root.is-sidebar-collapsed = root.width < 960px;
        }
    }

    // In-app Floating Picture-in-Picture state
    in-out property <bool> pip-dismissed: false;
    out property <bool> pip-active:
        root.current-page != "watch"
        && !root.fullscreen-mode
        && !root.pip-dismissed
        && (root.playback-state == "playing" || root.playback-state == "paused")
        && (root.selected-video-id != "" || root.selected-video-title != "");

    in-out property <string> current-page: "youtube-home";
    in-out property <[VideoItem]> videos;

    in-out property <bool> loading: false;
    in-out property <bool> loading-more: false;
    in-out property <bool> has-more: false;
    in-out property <string> status-text: "";

    in-out property <string> selected-video-id: "";
    in-out property <string> selected-video-title: "";
    in-out property <string> selected-video-channel: "";

    in-out property <[VideoItem]> history-videos;
    in-out property <bool> history-loading: false;
    in-out property <string> history-status: "";

    in-out property <string> provider-mode: "auto";
    in-out property <string> settings-status: "";
    in-out property <int> subscriptions-count: 0;
    in-out property <string> import-file-path: "";
    in-out property <string> import-status: "";
    in-out property <bool> import-is-error: false;
    in-out property <bool> import-loading: false;
    in-out property <string> search-query: "";

    in-out property <[string]> anime-qualities: ["Auto"];
    in-out property <string> selected-anime-title: "";
    in-out property <string> selected-anime-quality: "Auto";
    in-out property <string> selected-episode-title: "";
    in-out property <string> anime-status-text: "";
    in-out property <bool> anime-loading: false;

    // Anime library (Phase 5.5)
    in-out property <string> anime-view: "home";
    in-out property <bool> anime-plugins-ready: false;
    in-out property <string> anime-status-kind: "info";
    in-out property <string> anime-results-heading: "";
    in-out property <string> anime-selected-key: "";
    in-out property <[AnimeCard]> anime-continue-cards;
    in-out property <[AnimeCard]> anime-recent-cards;
    in-out property <[AnimeCard]> anime-favorite-cards;
    in-out property <[AnimeCard]> anime-result-cards;
    in-out property <string> anime-detail-title: "";
    in-out property <string> anime-detail-subtitle: "";
    in-out property <string> anime-detail-description: "";
    in-out property <string> anime-detail-badge: "";
    in-out property <image> anime-detail-poster;
    in-out property <bool> anime-detail-has-poster: false;
    in-out property <bool> anime-detail-favorite: false;
    in-out property <string> anime-detail-loading-text: "";
    in-out property <[EpisodeItem]> anime-episode-items;
    in-out property <int> anime-selected-episode-number: -1;
    in-out property <string> anime-resume-label: "";

    in-out property <[VideoItem]> library-videos;
    in-out property <[string]> playlist-names;

    in-out property <string> library-mode: "favorites";
    in-out property <string> selected-playlist: "";

    in-out property <bool> library-loading: false;
    in-out property <string> library-status: "";
    in-out property <string> watch-library-status: "";

    in-out property <bool> player-ready: false;
    in-out property <bool> player-paused: true;

    in-out property <float> playback-position: 0;
    in-out property <float> playback-duration: 0;
    in-out property <float> playback-volume: 70;

    in-out property <string> playback-state: "idle";
    in-out property <bool> fullscreen-mode: false;

    in-out property <bool> player-muted: false;

    // YouTube Home (Phase 5.5.2)
    in-out property <[VideoItem]> home-videos;
    in-out property <[VideoItem]> home-continue-videos;
    in-out property <[VideoItem]> home-favorite-videos;
    in-out property <bool> home-loading: false;
    in-out property <string> home-status-text: "";
    in-out property <string> home-selected-topic: "";

    // YouTube Trending (Option A)
    in-out property <[VideoItem]> trending-videos;
    in-out property <bool> trending-loading: false;
    in-out property <string> trending-status-text: "";
    in-out property <string> trending-selected-category: "";
    in-out property <string> trending-selected-country: "ID";

    // YouTube Subscriptions
    in-out property <[ChannelItem]> home-subscribed-channels;
    in-out property <[ChannelItem]> subscriptions-channels;
    in-out property <[VideoItem]> subscriptions-channel-videos;
    in-out property <bool> subscriptions-loading: false;
    in-out property <string> subscriptions-status-text: "";
    in-out property <string> subscriptions-filter-query: "";
    in-out property <string> subscriptions-selected-channel-id: "";
    in-out property <string> subscriptions-selected-channel-title: "";
    in-out property <int> subscriptions-current-page: 1;
    in-out property <int> subscriptions-total-pages: 1;
    in-out property <int> subscriptions-total-count: 0;
    in-out property <int> subscriptions-page-start: 0;
    in-out property <int> subscriptions-page-end: 0;
    in-out property <string> subscriptions-sort: "a-z";

    callback save-provider(string);
    callback select-import-file();
    callback import-subscriptions(string);
    callback clear-subscriptions();
    callback nav-subscriptions();
    callback load-subscriptions();
    callback filter-subscriptions(string);
    callback subscriptions-next-page();
    callback subscriptions-prev-page();
    callback subscriptions-first-page();
    callback subscriptions-last-page();
    callback subscriptions-change-sort(string);
    callback select-subscription-channel(string, string);
    callback clear-selected-subscription-channel();
    callback remove-subscription-channel(string);
    callback refresh-subscriptions();
    callback search(string);
    callback open-video(string);
    callback play-video(string);
    callback load-more();
    callback load-home();
    callback load-home-topic(string);
    callback load-trending();
    callback load-trending-category(string);
    callback toggle-trending-country();

    callback show-history();
    callback refresh-history();
    callback show-anime();
    callback anime-search(string);
    callback anime-select(string);
    callback anime-select-episode(int);
    callback anime-play();
    callback anime-resume();
    callback anime-toggle-favorite();
    callback anime-back();
    callback anime-play-ready(string, string);
    callback anime-install-plugins();

    callback show-library();
    callback refresh-library();
    callback select-playlist(string);
    callback create-playlist(string);

    callback toggle-favorite();
    callback add-to-playlist(string);

    callback toggle-playback();
    callback stop-playback();
    callback seek-playback(float);
    callback change-volume(float);

    callback replay-video();
    callback toggle-fullscreen();

    callback toggle-mute();

    callback open-video-browser(string);

    // Navigation stack (Phase 5.5.2)
    callback nav-back();
    callback nav-search(string);
    callback nav-history();
    callback nav-favorites();
    callback nav-library-playlist(string);
    callback nav-settings();
    callback nav-anime();
    callback nav-anime-details(string);
    callback nav-home();
    callback nav-watch();
    callback nav-trending();

    changed current-page => {
        if (root.current-page == "watch") {
            root.pip-dismissed = false;
            shortcut-scope.focus();
        }
    }

    out property <float> video-x:
        (root.current-page == "watch")
            ? (watch-page.video-surface-x / 1px)
            : (root.pip-active ? (pip-player.video-surface-x / 1px) : 0);

    out property <float> video-y:
        (root.current-page == "watch")
            ? (watch-page.video-surface-y / 1px)
            : (root.pip-active ? (pip-player.video-surface-y / 1px) : 0);

    out property <float> video-width:
        (root.current-page == "watch")
            ? (watch-page.video-surface-width / 1px)
            : (root.pip-active ? (pip-player.video-surface-width / 1px) : 0);

    out property <float> video-height:
        (root.current-page == "watch")
            ? (watch-page.video-surface-height / 1px)
            : (root.pip-active ? (pip-player.video-surface-height / 1px) : 0);

    /// True while the user is interacting with the seek slider. Read by Rust so
    /// live timeline updates do not yank the thumb mid-drag.
    in-out property <bool> timeline-seek-active: false;

    HorizontalLayout {
        spacing: 0px;

        if !root.fullscreen-mode: Sidebar {
            current-page: root.current-page;
            collapsed: root.is-sidebar-collapsed;

            nav-home => {
                root.nav-home();
            }

            nav-trending => {
                root.nav-trending();
            }

            nav-subscriptions => {
                root.nav-subscriptions();
            }

            nav-search => {
                root.nav-search(root.search-query);
            }

            nav-anime => {
                root.nav-anime();
            }

            nav-library => {
                root.library-mode = "favorites";
                root.selected-playlist = "";
                root.nav-favorites();
            }

            nav-history => {
                root.nav-history();
            }

            nav-settings => {
                root.nav-settings();
            }

            toggle-collapse => {
                root.user-collapsed = !root.is-sidebar-collapsed;
                root.is-sidebar-collapsed = !root.is-sidebar-collapsed;
            }
        }

        content-area := Rectangle {
            horizontal-stretch: 1;
            background: Theme.bg;
            clip: true;

            if root.current-page == "youtube-home": HomePage {
                width: parent.width;
                height: parent.height;
                videos: root.home-videos;
                continue-videos: root.home-continue-videos;
                favorite-videos: root.home-favorite-videos;
                subscribed-channels: root.home-subscribed-channels;
                home-loading: root.home-loading;
                home-status-text: root.home-status-text;
                selected-topic: root.home-selected-topic;

                search(query) => {
                    root.nav-search(query);
                }

                open-video(id) => {
                    root.open-video(id);
                }

                show-history => {
                    root.nav-history();
                }

                show-settings => {
                    root.nav-settings();
                }

                show-library => {
                    root.library-mode = "favorites";
                    root.selected-playlist = "";
                    root.nav-favorites();
                }

                show-favorites => {
                    root.nav-favorites();
                }

                show-anime => {
                    root.nav-anime();
                }

                show-subscriptions => {
                    root.nav-subscriptions();
                }

                select-channel(id, title) => {
                    root.select-subscription-channel(id, title);
                }

                select-topic(topic) => {
                    root.home-selected-topic = topic;
                    root.load-home-topic(topic);
                }

                load-more => {
                    root.load-more();
                }
            }

            if root.current-page == "trending": TrendingPage {
                width: parent.width;
                height: parent.height;
                videos: root.trending-videos;
                loading: root.trending-loading;
                status-text: root.trending-status-text;
                selected-category: root.trending-selected-category;
                selected-country: root.trending-selected-country;

                open-video(id) => {
                    root.open-video(id);
                }

                select-category(category) => {
                    root.trending-selected-category = category;
                    root.load-trending-category(category);
                }

                toggle-country => {
                    root.toggle-trending-country();
                }

                refresh => {
                    root.load-trending();
                }
            }

            if root.current-page == "subscriptions": SubscriptionsPage {
                width: parent.width;
                height: parent.height;
                channels: root.subscriptions-channels;
                channel-videos: root.subscriptions-channel-videos;
                loading: root.subscriptions-loading;
                status-text: root.subscriptions-status-text;
                filter-query <=> root.subscriptions-filter-query;
                selected-channel-id: root.subscriptions-selected-channel-id;
                selected-channel-title: root.subscriptions-selected-channel-title;

                current-page: root.subscriptions-current-page;
                total-pages: root.subscriptions-total-pages;
                total-count: root.subscriptions-total-count;
                page-start: root.subscriptions-page-start;
                page-end: root.subscriptions-page-end;
                selected-sort: root.subscriptions-sort;

                select-channel(id, title) => {
                    root.select-subscription-channel(id, title);
                }

                clear-selected-channel => {
                    root.clear-selected-subscription-channel();
                }

                remove-channel(id) => {
                    root.remove-subscription-channel(id);
                }

                refresh => {
                    root.refresh-subscriptions();
                }

                open-video(id) => {
                    root.open-video(id);
                }

                open-settings => {
                    root.nav-settings();
                }

                filter-changed(query) => {
                    root.filter-subscriptions(query);
                }

                next-page => {
                    root.subscriptions-next-page();
                }

                prev-page => {
                    root.subscriptions-prev-page();
                }

                first-page => {
                    root.subscriptions-first-page();
                }

                last-page => {
                    root.subscriptions-last-page();
                }

                sort-changed(sort) => {
                    root.subscriptions-change-sort(sort);
                }
            }

            if root.current-page == "search": SearchPage {
                width: parent.width;
                height: parent.height;
                videos: root.videos;
                loading: root.loading;
                loading-more: root.loading-more;
                has-more: root.has-more;
                status-text: root.status-text;
                search-query: root.search-query;

                search(query) => {
                    root.nav-search(query);
                }

                open-video(id) => {
                    root.open-video(id);
                }

                load-more => {
                    root.load-more();
                }

                show-history => {
                    root.nav-history();
                }

                show-settings => {
                    root.nav-settings();
                }

                show-library => {
                    root.library-mode = "favorites";
                    root.selected-playlist = "";
                    root.nav-favorites();
                }

                show-anime => {
                    root.nav-anime();
                }

                back => {
                    root.nav-back();
                }
            }

            if root.current-page == "anime": AnimePage {
                width: parent.width;
                height: parent.height;
                view: root.anime-view;
                plugins-ready: root.anime-plugins-ready;

                status-text: root.anime-status-text;
                status-kind: root.anime-status-kind;
                loading: root.anime-loading;

                continue-cards: root.anime-continue-cards;
                recent-cards: root.anime-recent-cards;
                favorite-cards: root.anime-favorite-cards;
                result-cards: root.anime-result-cards;
                results-heading: root.anime-results-heading;
                selected-key: root.anime-selected-key;

                detail-title: root.anime-detail-title;
                detail-subtitle: root.anime-detail-subtitle;
                detail-description: root.anime-detail-description;
                detail-badge: root.anime-detail-badge;
                detail-poster: root.anime-detail-poster;
                detail-has-poster: root.anime-detail-has-poster;
                detail-favorite: root.anime-detail-favorite;
                detail-loading-text: root.anime-detail-loading-text;
                episodes: root.anime-episode-items;
                selected-episode-number: root.anime-selected-episode-number;
                resume-label: root.anime-resume-label;

                qualities: root.anime-qualities;
                selected-quality: root.selected-anime-quality;

                search(query) => {
                    root.anime-search(query);
                }

                select-anime(key) => {
                    root.nav-anime-details(key);
                }

                select-episode(number) => {
                    root.anime-select-episode(number);
                }

                play => {
                    root.anime-play();
                }

                resume => {
                    root.anime-resume();
                }

                toggle-favorite => {
                    root.anime-toggle-favorite();
                }

                install-plugins => {
                    root.anime-install-plugins();
                }

                back => {
                    root.nav-back();
                }
            }

            shortcut-scope := FocusScope {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;

                visible: root.current-page == "watch";
                enabled: root.current-page == "watch";

                focus-on-click: true;

                capture-key-pressed(event) => {
                    if (root.current-page != "watch") {
                        return reject;
                    }
                    if (event.repeat
                        || event.modifiers.control
                        || event.modifiers.alt
                        || event.modifiers.meta) {
                        return reject;
                    }
                    if (event.text == " ") {
                        if (root.player-ready) {
                            root.toggle-playback();
                        }
                        return accept;
                    }
                    if (event.text == "f" || event.text == "F") {
                        if (root.player-ready) {
                            root.toggle-fullscreen();
                        }
                        return accept;
                    }
                    if (event.text == Key.Escape) {
                        if (root.fullscreen-mode) {
                            root.toggle-fullscreen();
                            return accept;
                        }
                    }
                    if (event.text == "m" || event.text == "M") {
                        if (root.player-ready) {
                            root.toggle-mute();
                        }
                        return accept;
                    }
                    reject
                }

                watch-page := WatchPage {
                    width: parent.width;
                    height: parent.height;

                    video-id: root.selected-video-id;
                    video-title: root.selected-video-title;
                    channel: root.selected-video-channel;

                    playlists: root.playlist-names;
                    library-status: root.watch-library-status;

                    player-ready: root.player-ready;
                    player-paused: root.player-paused;

                    playback-position <=> root.playback-position;
                    seeking <=> root.timeline-seek-active;
                    playback-duration: root.playback-duration;
                    playback-volume: root.playback-volume;
                    playback-state: root.playback-state;

                    fullscreen-mode: root.fullscreen-mode;

                    player-muted: root.player-muted;

                    back => {
                        root.nav-back();
                    }

                    play(id) => {
                        root.play-video(id);
                    }

                    toggle-playback => {
                        root.toggle-playback();
                    }

                    stop-playback => {
                        root.stop-playback();
                    }

                    seek-playback(value) => {
                        root.seek-playback(value);
                    }

                    change-volume(value) => {
                        root.change-volume(value);
                    }

                    replay => {
                        root.replay-video();
                    }

                    toggle-fullscreen => {
                        root.toggle-fullscreen();
                    }

                    toggle-favorite => {
                        root.toggle-favorite();
                    }

                    add-to-playlist(name) => {
                        root.add-to-playlist(name);
                    }

                    open-in-browser(id) => {
                        root.open-video-browser(id);
                    }
                }
            }

            if root.current-page == "history": HistoryPage {
                width: parent.width;
                height: parent.height;
                videos: root.history-videos;
                loading: root.history-loading;
                status-text: root.history-status;

                back => {
                    root.nav-back();
                }

                open-video(id) => {
                    root.open-video(id);
                }

                refresh => {
                    root.refresh-history();
                }
            }

            if root.current-page == "settings": SettingsPage {
                width: parent.width;
                height: parent.height;
                provider-mode: root.provider-mode;
                status-text: root.settings-status;
                subscriptions-count: root.subscriptions-count;
                import-file-path <=> root.import-file-path;
                import-status: root.import-status;
                import-is-error: root.import-is-error;
                import-loading: root.import-loading;

                back => {
                    root.nav-back();
                }

                save-provider(mode) => {
                    root.save-provider(mode);
                }

                select-import-file => {
                    root.select-import-file();
                }

                import-subscriptions(path) => {
                    root.import-subscriptions(path);
                }

                clear-subscriptions => {
                    root.clear-subscriptions();
                }

                nav-subscriptions => {
                    root.nav-subscriptions();
                }
            }

            if root.current-page == "library": LibraryPage {
                width: parent.width;
                height: parent.height;
                videos: root.library-videos;
                playlists: root.playlist-names;

                library-mode: root.library-mode;
                selected-playlist: root.selected-playlist;

                loading: root.library-loading;
                status-text: root.library-status;

                back => {
                    root.nav-back();
                }

                open-video(id) => {
                    root.open-video(id);
                }

                show-favorites => {
                    root.nav-favorites();
                }

                select-playlist(name) => {
                    root.library-mode = "playlist";
                    root.selected-playlist = name;
                    root.nav-library-playlist(name);
                }

                create-playlist(name) => {
                    root.create-playlist(name);
                }

                refresh => {
                    root.refresh-library();
                }
            }

            // In-App Floating Picture-in-Picture Mini-Player
            pip-player := FloatingPip {
                x: parent.width - self.width - 24px;
                y: parent.height - self.height - 24px;
                visible: root.pip-active;

                video-title: root.selected-video-title;
                video-channel: root.selected-video-channel;
                player-paused: root.player-paused;
                playback-state: root.playback-state;

                toggle-playback => {
                    root.toggle-playback();
                }

                close => {
                    root.pip-dismissed = true;
                    root.stop-playback();
                }

                expand => {
                    root.nav-watch();
                }
            }
        }
    }
}
