import {
    HomePage,
} from "pages/home-page.slint";
import {
    SearchPage,
} from "pages/search-page.slint";
import {
    WatchPage,
} from "pages/watch-page.slint";
import {
    AnimePage,
} from "pages/anime-page.slint";
import {
    AnimeCard,
} from "components/anime-poster-card.slint";
import {
    EpisodeItem,
} from "components/episode-row.slint";
import {
    VideoItem,
} from "components/video-card.slint";
import {
    HistoryPage,
} from "pages/history-page.slint";
import {
    SettingsPage,
} from "pages/settings-page.slint";
import {
    LibraryPage,
} from "pages/library-page.slint";

export component AppWindow inherits Window {
    title: "MutsukiTube";

    preferred-width: 1200px;
    preferred-height: 760px;

    min-width: 800px;
    min-height: 600px;

    in-out property <string> current-page: "youtube-home";
    in-out property <[VideoItem]> videos;

    in-out property <bool> loading: false;
    in-out property <bool> loading-more: false;
    in-out property <bool> has-more: false;
    in-out property <string> status-text: "";

    in-out property <string> selected-video-id: "";
    in-out property <string> selected-video-title: "";
    in-out property <string> selected-video-channel: "";

    in-out property <[VideoItem]> history-videos;
    in-out property <bool> history-loading: false;
    in-out property <string> history-status: "";

    in-out property <string> provider-mode: "auto";
    in-out property <string> settings-status: "";
    in-out property <string> search-query: "";

    in-out property <[string]> anime-qualities: ["Auto"];
    in-out property <string> selected-anime-title: "";
    in-out property <string> selected-anime-quality: "Auto";
    in-out property <string> selected-episode-title: "";
    in-out property <string> anime-status-text: "";
    in-out property <bool> anime-loading: false;

    // Anime library (Phase 5.5)
    in-out property <string> anime-view: "home";
    in-out property <bool> anime-plugins-ready: false;
    in-out property <string> anime-status-kind: "info";
    in-out property <string> anime-results-heading: "";
    in-out property <string> anime-selected-key: "";
    in-out property <[AnimeCard]> anime-continue-cards;
    in-out property <[AnimeCard]> anime-recent-cards;
    in-out property <[AnimeCard]> anime-favorite-cards;
    in-out property <[AnimeCard]> anime-result-cards;
    in-out property <string> anime-detail-title: "";
    in-out property <string> anime-detail-subtitle: "";
    in-out property <string> anime-detail-description: "";
    in-out property <string> anime-detail-badge: "";
    in-out property <image> anime-detail-poster;
    in-out property <bool> anime-detail-has-poster: false;
    in-out property <bool> anime-detail-favorite: false;
    in-out property <string> anime-detail-loading-text: "";
    in-out property <[EpisodeItem]> anime-episode-items;
    in-out property <int> anime-selected-episode-number: -1;
    in-out property <string> anime-resume-label: "";

    in-out property <[VideoItem]> library-videos;
    in-out property <[string]> playlist-names;

    in-out property <string> library-mode: "favorites";
    in-out property <string> selected-playlist: "";

    in-out property <bool> library-loading: false;
    in-out property <string> library-status: "";
    in-out property <string> watch-library-status: "";

    in-out property <bool> player-ready: false;
    in-out property <bool> player-paused: true;

    in-out property <float> playback-position: 0;
    in-out property <float> playback-duration: 0;
    in-out property <float> playback-volume: 70;

    in-out property <string> playback-state: "idle";
    in-out property <bool> fullscreen-mode: false;

    in-out property <bool> player-muted: false;

    // YouTube Home (Phase 5.5.2)
    in-out property <[VideoItem]> home-videos;
    in-out property <[VideoItem]> home-continue-videos;
    in-out property <[VideoItem]> home-favorite-videos;
    in-out property <bool> home-loading: false;
    in-out property <string> home-status-text: "";
    in-out property <string> home-selected-topic: "";

    callback save-provider(string);
    callback search(string);
    callback open-video(string);
    callback play-video(string);
    callback load-more();
    callback load-home();
    callback load-home-topic(string);

    callback show-history();
    callback refresh-history();
    callback show-anime();
    callback anime-search(string);
    callback anime-select(string);
    callback anime-select-episode(int);
    callback anime-play();
    callback anime-resume();
    callback anime-toggle-favorite();
    callback anime-back();
    callback anime-play-ready(string, string);
    callback anime-install-plugins();

    callback show-library();
    callback refresh-library();
    callback select-playlist(string);
    callback create-playlist(string);

    callback toggle-favorite();
    callback add-to-playlist(string);

    callback toggle-playback();
    callback stop-playback();
    callback seek-playback(float);
    callback change-volume(float);

    callback replay-video();
    callback toggle-fullscreen();

    callback toggle-mute();

    callback open-video-browser(string);

    // Navigation stack (Phase 5.5.2)
    callback nav-back();
    callback nav-search(string);
    callback nav-history();
    callback nav-favorites();
    callback nav-library-playlist(string);
    callback nav-settings();
    callback nav-anime();
    callback nav-anime-details(string);
    callback nav-home();

    changed current-page => {
        if (root.current-page == "watch") {
            shortcut-scope.focus();
        }
    }

    out property <float> video-x:
        watch-page.video-surface-x / 1px;

    out property <float> video-y:
        watch-page.video-surface-y / 1px;

    out property <float> video-width:
        watch-page.video-surface-width / 1px;

    out property <float> video-height:
        watch-page.video-surface-height / 1px;

    /// True while the user is interacting with the seek slider. Read by Rust so
    /// live timeline updates do not yank the thumb mid-drag.
    out property <bool> timeline-seek-active:
        watch-page.seeking;

    if root.current-page == "youtube-home": HomePage {
        videos: root.home-videos;
        continue-videos: root.home-continue-videos;
        favorite-videos: root.home-favorite-videos;
        home-loading: root.home-loading;
        home-status-text: root.home-status-text;
        selected-topic: root.home-selected-topic;

        search(query) => {
            root.nav-search(query);
        }

        open-video(id) => {
            root.open-video(id);
        }

        show-history => {
            root.nav-history();
        }

        show-settings => {
            root.nav-settings();
        }

        show-library => {
            root.library-mode = "favorites";
            root.selected-playlist = "";
            root.nav-favorites();
        }

        show-favorites => {
            root.nav-favorites();
        }

        show-anime => {
            root.nav-anime();
        }

        select-topic(topic) => {
            root.home-selected-topic = topic;
            root.load-home-topic(topic);
        }

        load-more => {
            root.load-more();
        }
    }

    if root.current-page == "search": SearchPage {
        videos: root.videos;
        loading: root.loading;
        loading-more: root.loading-more;
        has-more: root.has-more;
        status-text: root.status-text;
        search-query: root.search-query;

        search(query) => {
            root.nav-search(query);
        }

        open-video(id) => {
            root.open-video(id);
        }

        load-more => {
            root.load-more();
        }

        show-history => {
            root.nav-history();
        }

        show-settings => {
            root.nav-settings();
        }

        show-library => {
            root.library-mode = "favorites";
            root.selected-playlist = "";
            root.nav-favorites();
        }

        show-anime => {
            root.nav-anime();
        }

        back => {
            root.nav-back();
        }
    }

    if root.current-page == "anime": AnimePage {
        view: root.anime-view;
        plugins-ready: root.anime-plugins-ready;

        status-text: root.anime-status-text;
        status-kind: root.anime-status-kind;
        loading: root.anime-loading;

        continue-cards: root.anime-continue-cards;
        recent-cards: root.anime-recent-cards;
        favorite-cards: root.anime-favorite-cards;
        result-cards: root.anime-result-cards;
        results-heading: root.anime-results-heading;
        selected-key: root.anime-selected-key;

        detail-title: root.anime-detail-title;
        detail-subtitle: root.anime-detail-subtitle;
        detail-description: root.anime-detail-description;
        detail-badge: root.anime-detail-badge;
        detail-poster: root.anime-detail-poster;
        detail-has-poster: root.anime-detail-has-poster;
        detail-favorite: root.anime-detail-favorite;
        detail-loading-text: root.anime-detail-loading-text;
        episodes: root.anime-episode-items;
        selected-episode-number: root.anime-selected-episode-number;
        resume-label: root.anime-resume-label;

        qualities: root.anime-qualities;
        selected-quality: root.selected-anime-quality;

        search(query) => {
            root.anime-search(query);
        }

        select-anime(key) => {
            root.nav-anime-details(key);
        }

        select-episode(number) => {
            root.anime-select-episode(number);
        }

        play => {
            root.anime-play();
        }

        resume => {
            root.anime-resume();
        }

        toggle-favorite => {
            root.anime-toggle-favorite();
        }

        install-plugins => {
            root.anime-install-plugins();
        }

        back => {
            root.nav-back();
        }
    }

    shortcut-scope := FocusScope {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;

        visible: root.current-page == "watch";
        enabled: root.current-page == "watch";

        focus-on-click: true;

        capture-key-pressed(event) => {
            if (root.current-page != "watch") {
                return reject;
            }
            if (event.repeat
                || event.modifiers.control
                || event.modifiers.alt
                || event.modifiers.meta) {
                return reject;
            }
            if (event.text == " ") {
                if (root.player-ready) {
                    root.toggle-playback();
                }
                return accept;
            }
            if (event.text == "f" || event.text == "F") {
                if (root.player-ready) {
                    root.toggle-fullscreen();
                }
                return accept;
            }
            if (event.text == Key.Escape) {
                if (root.fullscreen-mode) {
                    root.toggle-fullscreen();
                    return accept;
                }
            }
            if (event.text == "m" || event.text == "M") {
                if (root.player-ready) {
                    root.toggle-mute();
                }
                return accept;
            }
            reject
        }

        watch-page := WatchPage {

            width: parent.width;
            height: parent.height;

            video-id: root.selected-video-id;
            video-title: root.selected-video-title;
            channel: root.selected-video-channel;

            playlists: root.playlist-names;
            library-status: root.watch-library-status;

            player-ready: root.player-ready;
            player-paused: root.player-paused;

            playback-position: root.playback-position;
            playback-duration: root.playback-duration;
            playback-volume: root.playback-volume;
            playback-state: root.playback-state;

            fullscreen-mode: root.fullscreen-mode;

            player-muted: root.player-muted;

            back => {
                root.nav-back();
            }

            play(id) => {
                root.play-video(id);
            }

            toggle-playback => {
                root.toggle-playback();
            }

            stop-playback => {
                root.stop-playback();
            }

            seek-playback(value) => {
                root.seek-playback(value);
            }

            change-volume(value) => {
                root.change-volume(value);
            }

            replay => {
                root.replay-video();
            }

            toggle-fullscreen => {
                root.toggle-fullscreen();
            }

            toggle-favorite => {
                root.toggle-favorite();
            }

            add-to-playlist(name) => {
                root.add-to-playlist(name);
            }

            open-in-browser(id) => {
                root.open-video-browser(id);
            }
        }
    }

    if root.current-page == "history": HistoryPage {
        videos: root.history-videos;
        loading: root.history-loading;
        status-text: root.history-status;

        back => {
            root.nav-back();
        }

        open-video(id) => {
            root.open-video(id);
        }

        refresh => {
            root.refresh-history();
        }
    }

    if root.current-page == "settings": SettingsPage {
        provider-mode: root.provider-mode;
        status-text: root.settings-status;

        back => {
            root.nav-back();
        }

        save-provider(mode) => {
            root.save-provider(mode);
        }
    }

    if root.current-page == "library": LibraryPage {
        videos: root.library-videos;
        playlists: root.playlist-names;

        library-mode: root.library-mode;
        selected-playlist: root.selected-playlist;

        loading: root.library-loading;
        status-text: root.library-status;

        back => {
            root.nav-back();
        }

        open-video(id) => {
            root.open-video(id);
        }

        show-favorites => {
            root.nav-favorites();
        }

        select-playlist(name) => {
            root.library-mode = "playlist";
            root.selected-playlist = name;
            root.nav-library-playlist(name);
        }

        create-playlist(name) => {
            root.create-playlist(name);
        }

        refresh => {
            root.refresh-library();
        }
    }
}
